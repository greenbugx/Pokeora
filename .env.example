# Copy this file to `.env` and replace the placeholders with real values.

# Connection string for PostgreSQL (authoritative game state).
# Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Discord bot credentials.
DISCORD_TOKEN=""
DISCORD_CLIENT_ID=""

# Optional: register slash commands to a single guild (faster during development).
# Leave empty for global command registration.
DISCORD_GUILD_ID=""

# Pokecoins granted to a player's wallet on registration.
INITIAL_POKECOINS=10000

# Optional Redis: caches exact catalog lookups (300s TTL) and pagination contexts.
# Leave empty to run on PostgreSQL alone (pagination falls back to the page option).
REDIS_URL="redis://localhost:6379"

# Pokémon TCG catalog synchronization (card/set sync worker).
POKEMON_TCG_API_BASE_URL="https://api.pokemontcg.io/v2"
POKEMON_TCG_API_KEY=""
# Assumed language of the source dataset (synchronization assumption, not API data).
POKEMON_TCG_SOURCE_LANGUAGE="EN"
